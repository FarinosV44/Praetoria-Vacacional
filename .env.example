# =============================================================================
# Praetoria Vacacional — environment
# Copy to .env.local and fill in. .env.local is gitignored. NEVER commit real keys.
# The app builds and runs with everything below left as placeholders (DEMO mode):
# no database, in-memory data seeded from src/content. See docs/SETUP.md.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Praetoria Vacacional

# --- Supabase (Postgres + Auth) -------------------------------------------
# Project Settings → API Keys. Leave as-is to run in DEMO mode.
# Apply the migrations before the first deploy: `supabase db push` (or run
# supabase/migrations/*.sql in order). See docs/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# New key names (preferred). The legacy names below still work as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable_key
SUPABASE_SECRET_KEY=your-sb_secret_key
# Legacy names — used only if the new ones above are unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
# Use TEST keys (sk_test_… / pk_test_…) until go-live.
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# From `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Praetoria Vacacional <reservas@tudominio.com>
EMAIL_REPLY_TO=hola@tudominio.com

# --- Admin panel --------------------------------------------------------
# Password to sign in at /admin. REQUIRED to use the admin panel.
ADMIN_PASSWORD=elige-una-contrasena-larga
# Long random string that signs the admin session cookie.
ADMIN_SESSION_SECRET=genera-otra-cadena-larga-aleatoria
# Comma-separated allowlist of emails (reserved for optional Supabase-Auth admin).
ADMIN_EMAILS=tu-email@ejemplo.com
# Role of the single admin login: admin | gestion | lectura (default admin).
# The capability matrix is ready for multi-user; today there is one login.
ADMIN_ROLE=admin

# --- iCal sync --------------------------------------------------------
# Random long string. Guards the export feeds and the import/cron endpoints.
ICAL_EXPORT_TOKEN=genera-una-cadena-larga-aleatoria
# Booking.com / Airbnb iCal IMPORT URLs. Preferred: save them from the admin
# "Sincronización" screen (persists in the DB). WITHOUT a database (DEMO mode)
# that value is wiped on every redeploy, so set the URL as an env var here /
# in the hosting panel instead — it is the durable fallback and survives deploys:
#   ICAL_IMPORT_<SLUG>_<CHANNEL>   (SLUG/CHANNEL upper-case)
# ICAL_IMPORT_VALENCIA_BOOKING=https://ical.booking.com/v1/export?t=...
# ICAL_IMPORT_JAVALAMBRE_BOOKING=https://ical.booking.com/v1/export?t=...
# ICAL_IMPORT_VALENCIA_AIRBNB=
# ICAL_IMPORT_JAVALAMBRE_AIRBNB=
# Resolution order: admin-saved value -> env var -> src/content/properties/<slug>.ts

# --- Analytics + Search Console (optional) ---------------------------
NEXT_PUBLIC_GA4_ID=
# The token from the "HTML tag" verification method in Google Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Observability (optional, issue #66) ----------------------------
# Structured JSON logging is always on. Set a Sentry DSN to also forward every
# server-side error (and browser errors via /api/observability/client-error) to
# Sentry — no SDK, just the DSN. NEXT_PUBLIC_SENTRY_DSN enables the browser path.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# debug | info | warn | error  (default: info in production, debug otherwise)
LOG_LEVEL=
# Overrides the environment tag on log lines / Sentry events (default: NODE_ENV).
OBSERVABILITY_ENV=
OBSERVABILITY_RELEASE=

# --- WhatsApp concierge (optional, issue #97) -----------------------
# E.164 digits only, no "+" or spaces, e.g. 34600111222. Empty → no button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Cron / internal auth (issue #64) --------------------------------
# Shared secret for the scheduled tasks (/api/cron/expire-holds, /api/ical/import).
# Vercel Cron sends it automatically as "Authorization: Bearer <value>" once set
# on the project. Use a long random string.
CRON_SECRET=

# --- Fail-closed production (issue #63) -----------------------------
# true → in NODE_ENV=production the server refuses to boot if a critical
# integration is missing (Supabase, Stripe, STRIPE_WEBHOOK_SECRET, CRON_SECRET,
# admin secret). Leave empty for staging / degraded deploys.
PRODUCTION_STRICT=

# --- Booking flow -----------------------------------------------------
RESERVATION_HOLD_MINUTES=30
