# =============================================================================
# Praetoria Vacacional — environment
# Copy to .env.local and fill in. .env.local is gitignored. NEVER commit real keys.
# The app builds and runs with everything below left as placeholders (DEMO mode):
# no database, in-memory data seeded from src/content. See docs/SETUP.md.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Praetoria Vacacional

# --- Supabase (Postgres + Auth) -------------------------------------------
# Project Settings → API. Leave as-is to run in DEMO mode.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
# Use TEST keys (sk_test_… / pk_test_…) until go-live.
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# From `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Praetoria Vacacional <reservas@tudominio.com>
EMAIL_REPLY_TO=hola@tudominio.com

# --- Admin panel --------------------------------------------------------
# Password to sign in at /admin. REQUIRED to use the admin panel.
ADMIN_PASSWORD=elige-una-contrasena-larga
# Long random string that signs the admin session cookie.
ADMIN_SESSION_SECRET=genera-otra-cadena-larga-aleatoria
# Comma-separated allowlist of emails (reserved for optional Supabase-Auth admin).
ADMIN_EMAILS=tu-email@ejemplo.com

# --- iCal sync --------------------------------------------------------
# Random long string. Guards the export feeds and the import/cron endpoints.
ICAL_EXPORT_TOKEN=genera-una-cadena-larga-aleatoria
# NOTE: the Booking.com iCal IMPORT URLs (one per property) are NOT env vars.
# Paste them into src/content/properties/<slug>.ts -> icalImportUrls[].url
# (or later from the admin "Sincronización" screen).

# --- Analytics + Search Console (optional) ---------------------------
NEXT_PUBLIC_GA4_ID=
# The token from the "HTML tag" verification method in Google Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Booking flow -----------------------------------------------------
RESERVATION_HOLD_MINUTES=30
